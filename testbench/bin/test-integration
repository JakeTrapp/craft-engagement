#!/usr/bin/env bash
# Run the Codeception integration suite inside DDEV against the guarded db_test database.
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$repo_dir"

lock_dir="$repo_dir/testbench/.test-run.lock"
mkdir -p "$repo_dir/testbench"
if ! mkdir "$lock_dir" 2>/dev/null; then
  printf '%s\n' "Another Engagement test suite owns db_test ($(cat "$lock_dir/owner" 2>/dev/null || echo unknown)). Wait for it, or remove a stale lock after confirming it has stopped." >&2
  exit 1
fi
printf 'integration pid %s\n' "$$" > "$lock_dir/owner"
trap 'rm -f "$lock_dir/owner"; rmdir "$lock_dir" 2>/dev/null || true' EXIT

testbench/bin/materialize
ddev start
ddev composer install --no-interaction
ddev exec -d /var/www/html/testbench php bin/create-test-database.php
ddev exec -d /var/www/html/testbench vendor/bin/codecept build
ddev exec -d /var/www/html/testbench vendor/bin/codecept run integration "$@"

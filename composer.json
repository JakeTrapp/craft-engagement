{
  "name": "jt-dev/craft-engagement",
  "description": "User engagement -- customizable ratings, likes, and favorites",
  "type": "craft-plugin",
  "license": "proprietary",
  "support": {
    "email": "jake.trapp02@gmail.com",
    "issues": "https://github.com/JakeTrapp/craft-engagement/issues?state=open",
    "source": "https://github.com/JakeTrapp/craft-engagement",
    "docs": "https://www.jtdevelop.com/development/plugins/engagement",
    "rss": "https://github.com/JakeTrapp/craft-engagement/releases.atom"
  },
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.0.0"
  },
  "require-dev": {
    "craftcms/ecs": "dev-main",
    "craftcms/phpstan": "dev-main",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "jtdev\\craftengagement\\": "src/"
    }
  },
  "extra": {
    "handle": "engagement",
    "name": "Engagement",
    "developer": "JTDev",
    "documentationUrl": "https://www.jtdevelop.com/development/plugins/engagement"
  },
  "scripts": {
    "check-cs": "ecs check --ansi",
    "fix-cs": "ecs check --ansi --fix",
    "phpstan": "phpstan --memory-limit=1G",
    "test:unit": "phpunit",
    "test:integration": "tests/integration/run",
    "test:browser": "npm run test:browser"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  },
  "archive": {
    "exclude": [
      "/vendor",
      "/node_modules",
      "/.ddev",
      "/testbench",
      "/tests",
      "/.env",
      "/.env.*",
      "/.phpunit.cache",
      "/phpunit.xml.dist",
      "/playwright.config.ts",
      "/package.json",
      "/package-lock.json",
      "/composer.lock",
      "/.DS_Store",
      "/playwright-report",
      "/test-results"
    ]
  }
}
